def parse_size(s):
    m=re.match(r'^(\d+)([KMG]?)$',str(s).strip().upper())
    if not m:raise argparse.ArgumentTypeError('use e.g. 10M, 512K, 1G')
    return int(m.group(1))*{'':1,'K':1024,'M':1024**2,'G':1024**3}[m.group(2)]
def run_server(a):
